// ─────────────────────────────────────────────────────────────────────────────
// examples/factorial.mini  —  Factorial recursivo
// ─────────────────────────────────────────────────────────────────────────────

/* Calcula n!
de forma recursiva */
func int factorial(int n) {
    if (n <= 1) {
        return 1;
}
    return n * factorial(n - 1);
}

func int main() {
    int i = 1;
while (i <= 8) {
        print(factorial(i));
        i = i + 1;
    }
}